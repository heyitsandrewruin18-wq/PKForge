<?xml version="1.0" encoding="utf-8"?>
<!-- What the launcher shows before PKForge's first picture: the shelf's empty cells (no claim about which sprites), so a host that photographs the widget early still keeps a real face. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToOutline="true"
    android:background="@drawable/home_widget_background">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:src="@drawable/sprites_widget_preview_image"
        android:contentDescription="@string/sprites_widget_description" />
</FrameLayout>
